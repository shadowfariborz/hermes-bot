# 🤖 Hermes Bot Configuration
# Copy this file to .env and fill in your values

# ── Required Settings ──────────────────────────────────────────────
# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Admin User ID (your Telegram user ID)
ADMIN_ID=your-user-id-here

# AI Model Settings
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4

# API Secret (change this to a random string!)
API_SECRET=change-this-to-a-random-string

# ── Optional Settings ──────────────────────────────────────────────
# GitHub Database (for searching through your data)
GITHUB_TOKEN=ghp_your-token-here
GITHUB_REPO=yourusername/your-repo

# ── Advanced Settings ──────────────────────────────────────────────
# Port (Railway sets this automatically)
# PORT=8080
